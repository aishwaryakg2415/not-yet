# Copy to .env and fill in. Never commit .env.
YOUCAM_API_KEY=
# India console keys use this host. Keep it unless your key came from the global console.
YOUCAM_BASE=https://yce-api-01.makeupar.com
# Scans allowed per day on the live demo (each scan = 14 units for 10 concerns, per the docs price table)
MAX_SCANS_PER_DAY=30
# Optional: enables "Ask about this product" (free key from https://aistudio.google.com)
GEMINI_API_KEY=
# Model(s) to try, in order
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-flash-lite-latest
MAX_ASKS_PER_DAY=200
